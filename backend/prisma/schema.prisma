generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  DOCTOR
  STAFF
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum SlotStatus {
  OPEN
  BOOKED
  CLOSED
}

enum SlotRequestStatus {
  PENDING
  CONFIRMED
  DECLINED
  CANCELLED
}

// Tenant: uma clínica/consultório. Todo dado clínico é isolado por clinicId.
model Clinic {
  id                String             @id @default(cuid())
  name              String
  slug              String             @unique
  createdAt         DateTime           @default(now())
  users             User[]
  patients          Patient[]
  appointments      Appointment[]
  availabilitySlots AvailabilitySlot[]
  slotRequests      SlotRequest[]
}

model User {
  id                String             @id @default(cuid())
  clinicId          String
  clinic            Clinic             @relation(fields: [clinicId], references: [id])
  name              String
  email             String             @unique
  passwordHash      String
  role              UserRole           @default(DOCTOR)
  createdAt         DateTime           @default(now())
  appointments      Appointment[]      @relation("DoctorAppointments")
  availabilitySlots AvailabilitySlot[] @relation("DoctorAvailability")

  @@index([clinicId])
}

model Patient {
  id           String        @id @default(cuid())
  clinicId     String
  clinic       Clinic        @relation(fields: [clinicId], references: [id])
  name         String
  phone        String?
  email        String?
  birthDate    DateTime?
  notes        String?
  createdAt    DateTime      @default(now())
  appointments Appointment[]
  slotRequests SlotRequest[]

  @@index([clinicId])
  @@index([clinicId, phone])
}

model Appointment {
  id        String            @id @default(cuid())
  clinicId  String
  clinic    Clinic            @relation(fields: [clinicId], references: [id])
  patientId String
  patient   Patient           @relation(fields: [patientId], references: [id])
  doctorId  String
  doctor    User              @relation("DoctorAppointments", fields: [doctorId], references: [id])
  startsAt  DateTime
  endsAt    DateTime
  status    AppointmentStatus @default(SCHEDULED)
  notes     String?
  createdAt DateTime          @default(now())

  @@index([clinicId, startsAt])
}

// Horário que o médico abre em sua agenda para pacientes solicitarem.
model AvailabilitySlot {
  id        String        @id @default(cuid())
  clinicId  String
  clinic    Clinic        @relation(fields: [clinicId], references: [id])
  doctorId  String
  doctor    User          @relation("DoctorAvailability", fields: [doctorId], references: [id])
  startsAt  DateTime
  endsAt    DateTime
  status    SlotStatus    @default(OPEN)
  createdAt DateTime      @default(now())
  requests  SlotRequest[]

  @@index([clinicId, doctorId, startsAt])
}

// Paciente "levanta a mão" para um horário disponível. Várias solicitações
// feitas na mesma submissão do paciente compartilham o mesmo groupId, assim
// confirmar uma cancela automaticamente as demais do mesmo grupo.
model SlotRequest {
  id        String             @id @default(cuid())
  clinicId  String
  clinic    Clinic             @relation(fields: [clinicId], references: [id])
  slotId    String
  slot      AvailabilitySlot   @relation(fields: [slotId], references: [id])
  patientId String
  patient   Patient            @relation(fields: [patientId], references: [id])
  groupId   String
  status    SlotRequestStatus  @default(PENDING)
  note      String?
  createdAt DateTime           @default(now())

  @@index([clinicId, status])
  @@index([slotId])
  @@index([groupId])
}
